{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tryout",
      "destination": "/teams-tryouts",
      "permanent": true
    },
    {
      "source": "/tryouts",
      "destination": "/teams-tryouts",
      "permanent": true
    },
    {
      "source": "/torneo",
      "destination": "/tournament",
      "permanent": true
    },
    {
      "source": "/precios",
      "destination": "/es/membresias",
      "permanent": true
    },
    {
      "source": "/softbol",
      "destination": "/softball",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}